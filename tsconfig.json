{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "resolveJsonModule": true, "skipLibCheck": true,
    "types": [],
    "paths": { "node:crypto": ["./shims/crypto.ts"], "node:fs": ["./shims/fs.ts"] }
  },
  "include": ["src/**/*.ts", "shims/**/*.ts", "engine/src/**/*.ts", "tools/**/*.ts"],
  "exclude": ["tools/exp/**"]
}
